NODE_ENV=production

# ---- Service Ports ----
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
LINKS_SERVICE_PORT=3002
ANALYTICS_SERVICE_PORT=3003
REDIRECT_SERVICE_PORT=3004

# ---- MongoDB ----
MONGO_URI=mongodb+srv://user:password@host/dbname

# ---- RabbitMQ ----
RABBITMQ_URI=amqps://user:password@host/vhost

# ---- JWT ----
# Short-lived access token (e.g. 15m, 30m)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRATION=30m

# Long-lived refresh token (e.g. 7d, 30d)
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRATION=30d

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=https://yourdomain.com

# ---- Docs App ----
# Public-facing gateway URL shown in the docs UI
API_BASE_URL=https://yourdomain.com
