---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const tiers = [
  {
    name: "Free",
    price: { monthly: 0, yearly: 0 },
    description: "Perfect for getting started with link management.",
    features: [
      "50 active short links",
      "1 bio/link-in-bio page",
      "QR code generator",
      "WhatsApp link generator",
      "30-day analytics",
      "jorh.net domain",
      "3 custom slugs",
    ],
    cta: "Get started free",
    href: "https://app.jorh.net/register",
    highlighted: false,
  },
  {
    name: "Pro",
    price: { monthly: 9, yearly: 90 },
    description: "For creators and solo entrepreneurs who need more.",
    features: [
      "Unlimited short links",
      "5 bio pages",
      "Custom domains (3)",
      "Password-protected links",
      "Expiring links",
      "1-year analytics retention",
      "Branded QR codes with logo",
      "Priority email support",
    ],
    cta: "Start Pro",
    href: "https://app.jorh.net/register?plan=pro",
    highlighted: true,
  },
  {
    name: "Business",
    price: { monthly: 29, yearly: 290 },
    description: "For teams that need collaboration and API access.",
    features: [
      "Everything in Pro",
      "5 team seats",
      "REST API access",
      "Webhooks",
      "Link rotator & A/B testing",
      "Smart geo/device targeting",
      "Bulk CSV import/export",
      "3-year analytics retention",
      "Zapier integration",
    ],
    cta: "Start Business",
    href: "https://app.jorh.net/register?plan=business",
    highlighted: false,
  },
];
---

<Layout
  title="Pricing — Jorh"
  description="Simple, transparent pricing. Free to start. Upgrade when you need more."
>
  <Nav />

  <main class="px-4 py-20 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="mb-16 text-center">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Simple pricing</h1>
        <p class="mx-auto mt-4 max-w-xl text-muted-foreground">
          Start free. Upgrade when you need more. No hidden fees, no surprises.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {
          tiers.map((tier) => (
            <div
              class:list={[
                "relative rounded-2xl border p-8 flex flex-col",
                tier.highlighted
                  ? "border-primary bg-gradient-to-b from-violet-50 to-white shadow-xl shadow-primary/10"
                  : "border-border bg-card",
              ]}
            >
              {tier.highlighted && (
                <div class="absolute -top-4 left-1/2 -translate-x-1/2">
                  <span class="rounded-full bg-primary px-4 py-1 text-xs font-semibold text-primary-foreground shadow">
                    Most popular
                  </span>
                </div>
              )}

              <div class="mb-6">
                <h2 class="text-lg font-semibold">{tier.name}</h2>
                <div class="mt-2 flex items-baseline gap-1">
                  <span class="text-4xl font-bold">
                    {tier.price.monthly === 0 ? "Free" : `$${tier.price.monthly}`}
                  </span>
                  {tier.price.monthly > 0 && (
                    <span class="text-sm text-muted-foreground">/month</span>
                  )}
                </div>
                {tier.price.yearly > 0 && (
                  <p class="mt-1 text-xs text-muted-foreground">
                    ${tier.price.yearly}/year — save ${tier.price.monthly * 12 - tier.price.yearly}
                  </p>
                )}
                <p class="mt-3 text-sm text-muted-foreground">{tier.description}</p>
              </div>

              <ul class="mb-8 flex-1 space-y-3">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-2 text-sm">
                    <span class="mt-0.5 text-emerald-500">✓</span>
                    {f}
                  </li>
                ))}
              </ul>

              <a
                href={tier.href}
                class:list={[
                  "block rounded-xl py-3 text-center text-sm font-semibold transition-all",
                  tier.highlighted
                    ? "bg-primary text-primary-foreground shadow hover:opacity-90"
                    : "border border-border hover:bg-muted",
                ]}
              >
                {tier.cta}
              </a>
            </div>
          ))
        }
      </div>

      <p class="mt-12 text-center text-sm text-muted-foreground">
        Need more? <a href="mailto:enterprise@jorh.net" class="text-primary underline underline-offset-4"
          >Talk to us about Enterprise</a
        >.
      </p>
    </div>
  </main>

  <Footer />
</Layout>
