---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="404 — Page Not Found | Jorh"
  description="The page you're looking for doesn't exist."
>
  <Nav />

  <main class="flex min-h-[calc(100dvh-8rem)] flex-col items-center justify-center px-4 text-center">
    <div class="mx-auto max-w-md">
      <div
        class="mb-6 inline-flex h-24 w-24 items-center justify-center rounded-3xl bg-gradient-to-br from-violet-100 to-indigo-100"
      >
        <span class="text-5xl">🔗</span>
      </div>

      <h1
        class="bg-gradient-to-r from-violet-600 to-indigo-500 bg-clip-text text-8xl font-black text-transparent"
      >
        404
      </h1>

      <h2 class="mt-4 text-2xl font-bold tracking-tight">This link is broken</h2>

      <p class="mx-auto mt-3 max-w-sm text-muted-foreground">
        The page you're looking for has either moved, been deleted, or never existed. Even the best
        links break sometimes.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/"
          class="w-full rounded-xl bg-primary px-6 py-2.5 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/25 transition-all hover:opacity-90 sm:w-auto"
        >
          ← Back to home
        </a>
        <a
          href="/tools/url-shortener"
          class="w-full rounded-xl border border-border px-6 py-2.5 text-sm font-semibold transition-colors hover:bg-muted sm:w-auto"
        >
          Shorten a link
        </a>
      </div>

      <p class="mt-12 text-xs text-muted-foreground">
        Looking for your shortened link?{" "}
        <a href="https://app.jorh.net" class="text-primary underline underline-offset-4">
          Sign in to your dashboard
        </a>
      </p>
    </div>
  </main>

  <Footer />
</Layout>
