---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const features = [
  {
    icon: "🔗",
    title: "URL Shortener",
    description: "Turn any long URL into a clean, trackable short link. Custom slugs and analytics included.",
    href: "/tools/url-shortener",
  },
  {
    icon: "🌿",
    title: "Link-in-Bio Pages",
    description: "Build a beautiful bio page with all your links in one place. Custom themes and analytics.",
    href: "#",
  },
  {
    icon: "📱",
    title: "QR Code Generator",
    description: "Generate QR codes for any URL with custom colors. Download as PNG or SVG.",
    href: "/tools/qr-generator",
  },
  {
    icon: "💬",
    title: "WhatsApp Links",
    description: "Create WhatsApp links with pre-filled messages. Perfect for business and marketing.",
    href: "/tools/whatsapp",
  },
  {
    icon: "📊",
    title: "Click Analytics",
    description: "See every click, from every channel. Country, device, browser, referrer — all tracked.",
    href: "#",
  },
  {
    icon: "🛠️",
    title: "UTM Builder",
    description: "Build UTM-tagged URLs for campaign tracking. Save templates for repeated use.",
    href: "#",
  },
];

const stats = [
  { value: "50+", label: "Tools in one platform" },
  { value: "<50ms", label: "Redirect speed globally" },
  { value: "Free", label: "To get started" },
];
---

<Layout title="Jorh — Every link, beautifully managed">
  <Nav />

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden px-4 pb-24 pt-20 sm:px-6 sm:pt-32">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_rgba(99,102,241,0.15),_transparent_60%)]"
      >
      </div>

      <div class="mx-auto max-w-4xl text-center">
        <div
          class="mb-6 inline-flex items-center gap-2 rounded-full border border-violet-200 bg-violet-50 px-4 py-1.5 text-sm text-violet-700"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-violet-500"></span>
          All tools. One workspace. Free to start.
        </div>

        <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">
          Every link,
          <span class="bg-gradient-to-r from-violet-600 to-indigo-500 bg-clip-text text-transparent">
            beautifully
          </span>
          managed
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-lg text-muted-foreground">
          Replace five link tools with one. Shorten URLs, build bio pages, generate QR codes, create
          social links, and track every click — all from a single beautiful dashboard.
        </p>

        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href="https://app.jorh.net/register"
            class="w-full rounded-xl bg-primary px-8 py-3 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 transition-all hover:opacity-90 hover:shadow-xl sm:w-auto"
          >
            Get started — it's free
          </a>
          <a
            href="/tools/url-shortener"
            class="w-full rounded-xl border border-border px-8 py-3 text-base font-semibold transition-colors hover:bg-muted sm:w-auto"
          >
            Try a tool →
          </a>
        </div>
      </div>

      <!-- Stats -->
      <div class="mx-auto mt-20 max-w-3xl">
        <dl class="grid grid-cols-3 gap-8 text-center">
          {
            stats.map((stat) => (
              <div>
                <dt class="text-3xl font-bold text-foreground sm:text-4xl">{stat.value}</dt>
                <dd class="mt-1 text-sm text-muted-foreground">{stat.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- Features Grid -->
    <section class="px-4 py-20 sm:px-6">
      <div class="mx-auto max-w-6xl">
        <div class="mb-12 text-center">
          <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Everything you need in one place</h2>
          <p class="mt-3 text-muted-foreground">
            Stop juggling multiple tools. Jorh brings them all together.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            features.map((feature) => (
              <a
                href={feature.href}
                class="group rounded-2xl border border-border bg-card p-6 transition-all hover:border-primary/40 hover:shadow-lg hover:shadow-primary/5"
              >
                <div class="mb-3 text-3xl">{feature.icon}</div>
                <h3 class="mb-2 font-semibold text-foreground">{feature.title}</h3>
                <p class="text-sm leading-relaxed text-muted-foreground">{feature.description}</p>
                <span class="mt-4 inline-block text-xs font-medium text-primary opacity-0 transition-opacity group-hover:opacity-100">
                  Try it free →
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="px-4 py-20 sm:px-6">
      <div
        class="mx-auto max-w-4xl rounded-3xl bg-gradient-to-br from-violet-600 to-indigo-600 px-8 py-16 text-center text-white"
      >
        <h2 class="text-3xl font-bold sm:text-4xl">Start managing your links today</h2>
        <p class="mx-auto mt-4 max-w-xl opacity-90">
          Free forever for individuals. No credit card required. Upgrade when you're ready.
        </p>
        <a
          href="https://app.jorh.net/register"
          class="mt-8 inline-block rounded-xl bg-white px-8 py-3 font-semibold text-violet-700 shadow-lg transition-transform hover:scale-105"
        >
          Create your free account
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
