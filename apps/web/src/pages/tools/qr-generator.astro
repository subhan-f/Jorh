---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="Free QR Code Generator — Jorh"
  description="Generate QR codes for any URL instantly. Custom colors, high resolution. Download as PNG or SVG. Free, no sign-up required."
>
  <Nav />

  <main class="px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-2xl">
      <div class="mb-10 text-center">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Free QR Code Generator</h1>
        <p class="mt-3 text-muted-foreground">
          Create a QR code for any URL in seconds. Custom colors and high resolution. No sign-up needed.
        </p>
      </div>

      <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
        <div class="space-y-4">
          <input
            id="qr-url"
            type="url"
            placeholder="Enter URL to generate QR code..."
            class="flex h-11 w-full rounded-xl border border-border bg-background px-4 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/40"
          />

          <div class="flex gap-4">
            <div class="flex-1">
              <label class="mb-1 block text-xs text-muted-foreground">Dark color</label>
              <input id="qr-dark" type="color" value="#000000" class="h-9 w-full cursor-pointer rounded-md border border-border" />
            </div>
            <div class="flex-1">
              <label class="mb-1 block text-xs text-muted-foreground">Light color</label>
              <input id="qr-light" type="color" value="#ffffff" class="h-9 w-full cursor-pointer rounded-md border border-border" />
            </div>
          </div>

          <button
            id="generate-btn"
            class="w-full rounded-xl bg-primary py-2.5 text-sm font-semibold text-primary-foreground hover:opacity-90 transition-opacity"
          >
            Generate QR Code
          </button>

          <div id="qr-preview" class="hidden text-center">
            <img id="qr-image" alt="Generated QR code" class="mx-auto rounded-xl border border-border" />
            <div class="mt-4 flex justify-center gap-3">
              <a
                id="download-png"
                download="jorh-qr.png"
                class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:bg-muted transition-colors"
              >
                Download PNG
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const btn = document.getElementById("generate-btn");
  const urlInput = document.getElementById("qr-url") as HTMLInputElement;
  const darkInput = document.getElementById("qr-dark") as HTMLInputElement;
  const lightInput = document.getElementById("qr-light") as HTMLInputElement;
  const preview = document.getElementById("qr-preview");
  const img = document.getElementById("qr-image") as HTMLImageElement;
  const downloadLink = document.getElementById("download-png") as HTMLAnchorElement;

  btn?.addEventListener("click", async () => {
    const url = urlInput.value.trim();
    if (!url) return;

    btn.textContent = "Generating…";
    (btn as HTMLButtonElement).disabled = true;

    try {
      const res = await fetch(`${import.meta.env.PUBLIC_API_URL ?? "http://localhost:3002"}/qr/generate`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          url,
          format: "dataurl",
          darkColor: darkInput.value,
          lightColor: lightInput.value,
          width: 400,
        }),
      });

      const { data } = await res.json();
      img.src = data.data;
      downloadLink.href = data.data;
      preview?.classList.remove("hidden");
    } finally {
      btn.textContent = "Generate QR Code";
      (btn as HTMLButtonElement).disabled = false;
    }
  });
</script>
