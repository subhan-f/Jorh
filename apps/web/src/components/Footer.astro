---
const year = new Date().getFullYear();

const links = {
  Tools: [
    { href: "/tools/url-shortener", label: "URL Shortener" },
    { href: "/tools/qr-generator", label: "QR Generator" },
    { href: "/tools/whatsapp", label: "WhatsApp Link" },
    { href: "/tools/utm-builder", label: "UTM Builder" },
  ],
  Product: [
    { href: "/pricing", label: "Pricing" },
    { href: "/blog", label: "Blog" },
    { href: "https://app.jorh.net", label: "Dashboard" },
  ],
  Legal: [
    { href: "/privacy", label: "Privacy Policy" },
    { href: "/terms", label: "Terms of Service" },
  ],
};
---

<footer class="border-border bg-muted/30 border-t">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="text-xl font-bold">
          <span
            class="bg-gradient-to-r from-violet-600 to-indigo-600 bg-clip-text text-transparent"
          >
            Jorh
          </span>
        </a>
        <p class="text-muted-foreground mt-2 max-w-xs text-sm">
          Every link, beautifully managed. The all-in-one link intelligence platform.
        </p>
      </div>

      {
        Object.entries(links).map(([category, items]) => (
          <div>
            <h3 class="mb-3 text-sm font-semibold">{category}</h3>
            <ul class="space-y-2">
              {items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-muted-foreground hover:text-foreground text-sm transition-colors"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="border-border text-muted-foreground mt-12 border-t pt-6 text-center text-xs">
      © {year} Jorh. All rights reserved. Built with ♥ by <a
        style="color: blue; text-decoration: underline;"
        href="https://subhanfarrakh.com">Subhan F.</a
      >
    </div>
  </div>
</footer>
